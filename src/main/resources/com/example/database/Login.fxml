<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.database.LoginController"
            prefWidth="450"
            prefHeight="400"
            style="-fx-background-color: #F4F6FB;">

    <children>
        <VBox spacing="12"
              alignment="CENTER"
              layoutX="50"
              layoutY="30"
              prefWidth="350"
              style="-fx-background-color: #FFFFFF;
                     -fx-padding: 25;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);">


            <!-- Заголовок -->
            <Label text="Система учёта колледжа"
                   style="-fx-font-size: 22px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1F2937;"/>

            <Label text="База данных студентов, преподавателей и групп"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #6B7280;"/>

            <Region prefHeight="10"/>

            <Label text="Вход в систему"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2F5BEA;"/>

            <TextField fx:id="usernameField"
                       promptText="Имя пользователя"
                       style="-fx-background-radius: 6;
                              -fx-border-radius: 6;
                              -fx-border-color: #D1D5DB;
                              -fx-padding: 8;
                              -fx-font-size: 14px;"/>

            <PasswordField fx:id="passwordField"
                           promptText="Пароль"
                           style="-fx-background-radius: 6;
                                  -fx-border-radius: 6;
                                  -fx-border-color: #D1D5DB;
                                  -fx-padding: 8;
                                  -fx-font-size: 14px;"/>

            <!-- Подпись для выбора роли -->
            <Label text="Выберите роль:"
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #6B7280;"/>

            <ChoiceBox fx:id="roleChoiceBox"
                       prefWidth="200"
                       style="-fx-background-radius: 6;
                              -fx-border-radius: 6;
                              -fx-border-color: #D1D5DB;
                              -fx-font-size: 14px;"/>

            <HBox spacing="15" alignment="CENTER">
                <Button text="Войти"
                        prefWidth="120"
                        onAction="#handleLogin"
                        style="-fx-background-color: #2F5BEA;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>

                <Button text="Регистрация"
                        prefWidth="120"
                        onAction="#handleRegister"
                        style="-fx-background-color: #6B7280;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>
            </HBox>

            <Hyperlink text="Забыли пароль?"
                       onAction="#handleForgotPassword"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #2F5BEA;"/>

            <Label fx:id="errorLabel"
                   text=""
                   style="-fx-text-fill: #E11D48;
                          -fx-font-size: 12px;"/>

        </VBox>
    </children>
</AnchorPane>
